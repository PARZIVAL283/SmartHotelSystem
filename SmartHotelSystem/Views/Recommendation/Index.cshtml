@model SmartHotelSystem.ViewModels.RecommendationViewModel

@{
    ViewData["Title"] = "AI Room Recommendation";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-dark text-white text-center py-4">

                    <h2 class="mb-2">
                        <i class="bi bi-stars"></i>
                        AI Room Recommendation
                    </h2>

                    <p class="mb-0">
                        Tell us your budget and preferences. Gemini AI will suggest the best room for you.
                    </p>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Index" method="post" id="recommendForm">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-4">

                            <label asp-for="Budget" class="form-label fw-bold"></label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-cash-stack"></i>
                                </span>

                                <input asp-for="Budget"
                                       class="form-control"
                                       placeholder="Enter your budget in BDT" />

                            </div>

                            <span asp-validation-for="Budget" class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Guests" class="form-label fw-bold"></label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-people-fill"></i>
                                </span>

                                <input asp-for="Guests"
                                       class="form-control"
                                       placeholder="Number of guests" />

                            </div>

                            <span asp-validation-for="Guests" class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Preference" class="form-label fw-bold"></label>

                            <textarea asp-for="Preference"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Example: Sea view, Honeymoon, Business trip, Family vacation"></textarea>

                            <span asp-validation-for="Preference" class="text-danger"></span>

                        </div>

                        <div class="d-grid">

                            <button type="submit" class="btn btn-primary btn-lg">

                                <i class="bi bi-robot"></i>

                                Get AI Recommendation

                            </button>

                        </div>

                    </form>

                    <div id="loading" class="text-center mt-4" style="display:none;">

                        <div class="spinner-border text-primary"></div>

                        <p class="mt-3 fw-semibold">

                            Gemini AI is analyzing your request...

                        </p>

                    </div>

                </div>

            </div>

            @if (!string.IsNullOrEmpty(Model.Recommendation))
            {
                <div class="card shadow-lg border-success mt-4">

                    <div class="card-header bg-success text-white">

                        <h4 class="mb-0">

                            <i class="bi bi-lightbulb-fill"></i>

                            AI Recommendation

                        </h4>

                    </div>

                    <div class="card-body">

                        <div class="ai-response">

                            @Model.Recommendation

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.getElementById("recommendForm")
            .addEventListener("submit", function () {

                document.getElementById("loading").style.display = "block";

            });

    </script>
}
