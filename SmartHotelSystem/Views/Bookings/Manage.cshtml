@model IEnumerable<SmartHotelSystem.Models.Booking>
@using SmartHotelSystem.Models

@{
    ViewData["Title"] = "Manage Bookings";
}

<div class="container py-4">

    <div class="text-center mb-5">

        <h2 class="fw-bold">
            <i class="bi bi-calendar2-check-fill text-primary"></i>
            Booking Management
        </h2>

        <p class="text-muted">
            Review, confirm and manage hotel reservations.
        </p>

    </div>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-lg-6 mb-4">

                <div class="card booking-card h-100">

                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>

                                <h4 class="fw-bold">

                                    <i class="bi bi-door-open-fill text-primary"></i>

                                    Room @item.Room?.RoomNumber

                                </h4>

                                <p class="text-muted mb-1">

                                    <i class="bi bi-person-circle"></i>

                                    @item.User?.Email

                                </p>

                            </div>

                            <div>

                                @if (item.Status == BookingStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark fs-6">
                                        Pending
                                    </span>
                                }
                                else if (item.Status == BookingStatus.Confirmed)
                                {
                                    <span class="badge bg-success fs-6">
                                        Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6">
                                        Cancelled
                                    </span>
                                }

                            </div>

                        </div>

                        <hr>

                        <div class="row">

                            <div class="col-6">

                                <small class="text-muted">

                                    Check-In

                                </small>

                                <h6>

                                    <i class="bi bi-calendar-event"></i>

                                    @item.CheckInDate.ToString("dd MMM yyyy")

                                </h6>

                            </div>

                            <div class="col-6">

                                <small class="text-muted">

                                    Check-Out

                                </small>

                                <h6>

                                    <i class="bi bi-calendar-event-fill"></i>

                                    @item.CheckOutDate.ToString("dd MMM yyyy")

                                </h6>

                            </div>

                        </div>

                        <hr>

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <small class="text-muted">

                                    Total Amount

                                </small>

                                <h4 class="text-success">

                                    ৳ @item.TotalPrice

                                </h4>

                            </div>

                            <div>

                                @if (item.Status == BookingStatus.Pending)
                                {
                                    <a asp-action="Confirm"
                                       asp-route-id="@item.Id"
                                       class="btn btn-success">

                                        <i class="bi bi-check-circle-fill"></i>

                                        Confirm

                                    </a>

                                    <a asp-action="Cancel"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger">

                                        <i class="bi bi-x-circle-fill"></i>

                                        Cancel

                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" disabled>

                                        Completed

                                    </button>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>