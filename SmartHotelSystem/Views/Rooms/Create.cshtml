@model SmartHotelSystem.Models.Room

@{
    ViewData["Title"] = "Add New Room";
}

<div class="container py-4">

    <div class="text-center mb-4">

        <h2 class="fw-bold">
            <i class="bi bi-plus-circle-fill text-primary"></i>
            Add New Room
        </h2>

        <p class="text-muted">
            Fill in the room information below to add a new room.
        </p>

    </div>

    <div class="card shadow-lg border-0">

        <div class="card-body p-4">

            <form asp-action="Create" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="RoomNumber" class="form-label fw-semibold"></label>

                        <input asp-for="RoomNumber"
                               class="form-control"
                               placeholder="Example: 101" />

                        <span asp-validation-for="RoomNumber" class="text-danger"></span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Category" class="form-label fw-semibold"></label>

                        <select asp-for="Category" class="form-select">
                            <option value="">Select Category</option>
                            <option>Single</option>
                            <option>Double</option>
                            <option>Deluxe</option>
                            <option>Suite</option>
                            <option>Family</option>
                            <option>Executive</option>
                        </select>

                        <span asp-validation-for="Category" class="text-danger"></span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label asp-for="PricePerNight" class="form-label fw-semibold"></label>

                        <input asp-for="PricePerNight"
                               class="form-control"
                               placeholder="5000" />

                        <span asp-validation-for="PricePerNight" class="text-danger"></span>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label asp-for="Capacity" class="form-label fw-semibold"></label>

                        <input asp-for="Capacity"
                               class="form-control"
                               placeholder="2" />

                        <span asp-validation-for="Capacity" class="text-danger"></span>

                    </div>

                    <div class="col-md-4 mb-3 d-flex align-items-end">

                        <div class="form-check">

                            <input asp-for="IsAvailable" class="form-check-input" />

                            <label asp-for="IsAvailable" class="form-check-label fw-semibold">
                                Available
                            </label>

                        </div>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="Description" class="form-label fw-semibold"></label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the room, facilities, and view..."></textarea>

                    <span asp-validation-for="Description" class="text-danger"></span>

                </div>

                <div class="mb-4">

                    <label asp-for="ImageFile" class="form-label fw-semibold"></label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*"
                           onchange="previewImage(event)" />

                    <span asp-validation-for="ImageFile" class="text-danger"></span>

                </div>

                <div class="text-center mb-4">

                    <img id="preview"
                         src="https://placehold.co/500x300?text=Room+Preview"
                         class="img-fluid rounded shadow"
                         style="max-height:250px; object-fit:cover;" />

                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">

                        <i class="bi bi-check-circle-fill"></i>
                        Create Room

                    </button>

                    <a asp-action="Index" class="btn btn-secondary">

                        <i class="bi bi-arrow-left-circle"></i>
                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        function previewImage(event) {

            const reader = new FileReader();

            reader.onload = function() {
                document.getElementById("preview").src = reader.result;
            };

            reader.readAsDataURL(event.target.files[0]);
        }
    </script>
}