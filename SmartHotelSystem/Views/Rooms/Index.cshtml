@model IEnumerable<SmartHotelSystem.Models.Room>

@{
    ViewData["Title"] = "Rooms";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-door-open-fill"></i>
                Our Rooms
            </h2>

            <p class="text-muted">
                Find the perfect room for your stay.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Add Room
            </a>
        }

    </div>


    <!-- SEARCH -->

    <form method="get" class="card p-3 mb-4 shadow-sm">

        <div class="row g-3">

            <div class="col-md-3">
                <input name="search"
                       value="@Context.Request.Query["search"]"
                       class="form-control"
                       placeholder="Room Number / Category" />
            </div>

            <div class="col-md-2">
                <input name="maxPrice"
                       value="@Context.Request.Query["maxPrice"]"
                       class="form-control"
                       type="number"
                       placeholder="Max Price" />
            </div>

            <div class="col-md-2">
                <input name="capacity"
                       value="@Context.Request.Query["capacity"]"
                       class="form-control"
                       type="number"
                       placeholder="Guests" />
            </div>

            <div class="col-md-2 d-flex align-items-center">

                <input class="form-check-input me-2"
                       type="checkbox"
                       name="availableOnly"
                       value="true"
                @(Context.Request.Query["availableOnly"] == "true" ? "checked" : "") />

                <label>Available Only</label>

            </div>

            <div class="col-md-3">

                <button class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                    Search
                </button>

            </div>

        </div>

    </form>


    <div class="row">

        @foreach (var room in Model)
        {
            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card room-card h-100">

                    <img src="@room.ImageUrl"
                         class="card-img-top room-image"
                         alt="Room Image" />

                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <h5 class="fw-bold">
                                Room @room.RoomNumber
                            </h5>

                            @if (room.IsAvailable)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Booked
                                </span>
                            }

                        </div>

                        <p class="text-primary fw-semibold mb-2">
                            @room.Category
                        </p>

                        <p class="text-muted">
                            @room.Description
                        </p>

                        <hr />

                        <div class="d-flex justify-content-between">

                            <span>
                                <i class="bi bi-people-fill"></i>
                                @room.Capacity Guests
                            </span>

                            <span class="fw-bold text-success">
                                $@room.PricePerNight / Night
                            </span>

                        </div>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <div class="d-grid gap-2">

                            <a asp-action="Details"
                               asp-route-id="@room.Id"
                               class="btn btn-outline-primary">
                                Details
                            </a>

                            @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                            {
                                <a asp-controller="Bookings"
                                   asp-action="Create"
                                   asp-route-roomId="@room.Id"
                                   class="btn btn-success">
                                    Book Now
                                </a>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@room.Id"
                                       class="btn btn-warning w-100">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@room.Id"
                                       class="btn btn-danger w-100">
                                        Delete
                                    </a>

                                </div>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>