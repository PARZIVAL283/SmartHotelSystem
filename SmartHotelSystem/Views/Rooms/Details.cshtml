@model SmartHotelSystem.Models.Room

@{
    ViewData["Title"] = "Room Details";
}

<div class="container">

    <a asp-action="Index" class="btn btn-outline-secondary mb-4">
        <i class="bi bi-arrow-left"></i>
        Back to Rooms
    </a>

    <div class="card shadow-lg border-0">

        <div class="row g-0">

            <!-- Image -->

            <div class="col-lg-6">

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         class="img-fluid w-100 h-100"
                         style="object-fit:cover; min-height:450px;" />
                }
                else
                {
                    <img src="/images/no-image.png"
                         class="img-fluid w-100 h-100"
                         style="object-fit:cover; min-height:450px;" />
                }

            </div>

            <!-- Details -->

            <div class="col-lg-6">

                <div class="card-body p-5">

                    <h2 class="fw-bold">
                        Room @Model.RoomNumber
                    </h2>

                    <h4 class="text-primary mb-4">
                        @Model.Category
                    </h4>

                    <p class="text-muted">
                        @Model.Description
                    </p>

                    <hr />

                    <div class="row">

                        <div class="col-6 mb-3">

                            <h6 class="text-muted">
                                Price
                            </h6>

                            <h4 class="text-success">
                                $@Model.PricePerNight
                                <small>/ Night</small>
                            </h4>

                        </div>

                        <div class="col-6 mb-3">

                            <h6 class="text-muted">
                                Capacity
                            </h6>

                            <h4>
                                <i class="bi bi-people-fill"></i>
                                @Model.Capacity Guests
                            </h4>

                        </div>

                    </div>

                    <div class="mb-4">

                        @if (Model.IsAvailable)
                        {
                            <span class="badge bg-success fs-6">
                                Available
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">
                                Currently Booked
                            </span>
                        }

                    </div>

                    @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
                    {
                        <a asp-controller="Bookings"
                           asp-action="Create"
                           asp-route-roomId="@Model.Id"
                           class="btn btn-success btn-lg">
                            <i class="bi bi-calendar-check"></i>
                            Book This Room
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mt-3">

                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn btn-warning">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@Model.Id"
                               class="btn btn-danger">
                                Delete
                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>