@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section text-white rounded-4 shadow-lg">

    <div class="hero-overlay">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-lg-7">

                    <h1 class="display-3 fw-bold">
                        Welcome to
                        <span class="text-warning">SmartHotel</span>
                    </h1>

                    <p class="lead mt-3">
                        Book luxury rooms effortlessly with our AI-powered hotel reservation system.
                        Find the perfect room based on your budget and preferences.
                    </p>

                    <div class="mt-4">

                        <a asp-controller="Rooms"
                           asp-action="Index"
                           class="btn btn-warning btn-lg me-3">

                            <i class="bi bi-door-open"></i>
                            Explore Rooms

                        </a>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a asp-controller="Recommendation"
                               asp-action="Index"
                               class="btn btn-outline-light btn-lg">

                                <i class="bi bi-stars"></i>
                                AI Recommendation

                            </a>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Register"
                               class="btn btn-outline-light btn-lg">

                                <i class="bi bi-person-plus"></i>
                                Get Started

                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- Features -->

<section class="mt-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold">
            Why Choose SmartHotel?
        </h2>

        <p class="text-muted">
            Modern technology for a better hotel booking experience.
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card h-100 text-center p-4">

                <i class="bi bi-stars feature-icon"></i>

                <h4 class="mt-3">
                    AI Recommendation
                </h4>

                <p>
                    Receive intelligent room suggestions based on your budget,
                    number of guests, and preferences.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card h-100 text-center p-4">

                <i class="bi bi-calendar-check feature-icon"></i>

                <h4 class="mt-3">
                    Easy Booking
                </h4>

                <p>
                    Book rooms within seconds using a clean and user-friendly interface.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card h-100 text-center p-4">

                <i class="bi bi-shield-check feature-icon"></i>

                <h4 class="mt-3">
                    Secure Reservation
                </h4>

                <p>
                    Built with ASP.NET Core Identity to ensure secure authentication
                    and reliable bookings.
                </p>

            </div>

        </div>

    </div>

</section>

<!-- Statistics -->

<section class="mt-5">

    <div class="row text-center">

        <div class="col-md-3">

            <div class="card p-4">

                <h2 class="text-primary">100+</h2>

                <p>Happy Guests</p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card p-4">

                <h2 class="text-success">50+</h2>

                <p>Luxury Rooms</p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card p-4">

                <h2 class="text-warning">24/7</h2>

                <p>Customer Support</p>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card p-4">

                <h2 class="text-danger">AI</h2>

                <p>Powered Recommendation</p>

            </div>

        </div>

    </div>

</section>

<!-- CTA -->

<section class="text-center mt-5 mb-5">

    <h2 class="fw-bold">
        Ready to Book Your Stay?
    </h2>

    <p class="text-muted">
        Explore our rooms and enjoy a smarter booking experience.
    </p>

    <a asp-controller="Rooms"
       asp-action="Index"
       class="btn btn-primary btn-lg">

        Book Now

    </a>

</section>