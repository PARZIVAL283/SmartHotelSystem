@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <i class="bi bi-shield-lock-fill text-primary" style="font-size:70px;"></i>

        <h1 class="display-5 fw-bold mt-3">
            Privacy Policy
        </h1>

        <p class="lead text-muted">
            Your privacy and personal information are important to us.
        </p>

    </div>

    <div class="card shadow-lg border-0">

        <div class="card-body p-5">

            <h3 class="fw-bold mb-3">
                <i class="bi bi-person-lock"></i>
                Information We Collect
            </h3>

            <p class="text-muted">
                When you register or make a reservation, we may collect your name,
                email address, booking details, and other information required to
                provide hotel reservation services.
            </p>

            <hr />

            <h3 class="fw-bold mb-3">
                <i class="bi bi-database-fill-lock"></i>
                How We Use Your Information
            </h3>

            <ul class="list-group list-group-flush mb-4">

                <li class="list-group-item">
                    ✔ Process hotel reservations
                </li>

                <li class="list-group-item">
                    ✔ Manage your account securely
                </li>

                <li class="list-group-item">
                    ✔ Improve customer experience
                </li>

                <li class="list-group-item">
                    ✔ Generate AI-powered room recommendations
                </li>

            </ul>

            <hr />

            <h3 class="fw-bold mb-3">
                <i class="bi bi-shield-check"></i>
                Data Protection
            </h3>

            <p class="text-muted">
                Your information is stored securely using ASP.NET Identity
                authentication and SQL Server. We do not share your personal
                information with third parties without your consent.
            </p>

            <hr />

            <h3 class="fw-bold mb-3">
                <i class="bi bi-cookie"></i>
                Cookies
            </h3>

            <p class="text-muted">
                This application may use cookies to improve user experience,
                maintain login sessions, and provide secure authentication.
            </p>

            <hr />

            <h3 class="fw-bold mb-3">
                <i class="bi bi-envelope-fill"></i>
                Contact Us
            </h3>

            <p class="text-muted mb-0">
                If you have any questions regarding this Privacy Policy,
                please contact the Smart Hotel Reservation System administrator.
            </p>

        </div>

    </div>

</div>